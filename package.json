{
  "name": "@quotient-forecasting/strats",
  "version": "0.2.0",
  "description": "Non-custodial runner for TokenStrats: reads declarative targets from Quotient and trades them from your own wallet on Hyperliquid or Polymarket",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "strats": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@quotient-forecasting/cassie-core": "0.4.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
